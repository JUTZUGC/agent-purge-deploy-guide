    "deploy": {
      "type": "script",
      "requires": [
        "node"
      ],
      "steps": [
        "npm install -g agent-purge",
        "agent-purge web",
        "echo \"控制台：http://127.0.0.1:7788\""
      ],
      "stepsPs": [
        "npm install -g agent-purge",
        "agent-purge web",
        "Write-Host \"控制台：http://127.0.0.1:7788\""
      ],
      "source": "https://github.com/ZiChuanLan/agent-purge#快速开始"
    },
    "pitfalls": [
      "命令找不到：确认 npm 全局目录在 PATH，重开终端",
